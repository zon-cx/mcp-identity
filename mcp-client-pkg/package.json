  "description": "MCP Client utilities for Identity Gateway",
  "module": "./dist/index.mjs",
  "commonjs": "./dist/index.cjs",
  "type": "module",
  "scripts": {
    "build": "pkgroll --clear-dist --dist ./dist --shims --treeshake  -y",
    "dev": "tsx --watch src/index.ts",
    "test": "echo \"No tests specified\""
  },
  "dependencies": {
    "xstate": "^5.19.2",
    "yjs": "*",
    "zod": "^3.22.4",
    "dotenv": "^16.5.0"
  },
  "peerDependencies": {
    "yjs": "*",
    "@hocuspocus/provider": "*"
  },
  "devDependencies": { 
    "@types/node": "^20.11.18",
    "typescript": "^5",
    "tsx": "^4.19.4",
    "@modelcontextprotocol/sdk": "^1.17.1",
    "@xstate/store": "^3.8.4"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",

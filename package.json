{
  "name": "mcp-identity-monorepo",
  "version": "1.22.22",
  "description": "MCP Identity Gateway Monorepo",
  "private": true,
  "workspaces": [
    "mcp-clients/*",
    "mcp-servers/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --filter \"!@mcp-identity/web\" --filter \"!@mcp-identity/dashboard\" --filter \"!@mcp-identity/discovery\" dev",
    "test": "pnpm -r test",
    "deploy": "mbt build  && cf deploy mta_archives/mcp-identity_1.0.0.mtar  --retries 1 -f",
    "start:slack": "pnpm --filter slack start",
    "start:web": "pnpm --filter web start",
    "start:router": "pnpm --filter router start",
    "start:discovery": "pnpm --filter discovery start",
    "start:dashboard": "pnpm --filter dashboard start",
    "start:whoami": "pnpm --filter whoami start",
    "dev:router": "PORT=8090 BASE_URL=http://localhost:8090 pnpm --filter @mcp-identity/router dev",
    "start:inspector": "DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector@latest"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "pkgroll": "^2.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5"
  },
  "engines": {
    "yarn": ">=1.22.0",
    "node": ">=22.16.0",
    "npm": ">=10.9.2"
  },
  "dependencies": {
    "@hocuspocus/provider": "^3.2.2",
    "@xstate/store": "^3.8.4"
  }
}
{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "Dom.Iterable",
      "webworker"
    ],
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "resolveJsonModule": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@mcp-client/sdk": ["./mcp-client"],
      "@mcp-client/sdk/*": [
        "./mcp-client/*"
      ]
    },
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noEmitOnError": false
  },

  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "tests/fixtures",
    "tests/fixtures/*",
    "tests/fixtures/*/*"
  ]
}
